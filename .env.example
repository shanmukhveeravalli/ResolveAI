# ==============================================================================
# ResolveAI — Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit the real .env file or real secrets to source control.
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resolveai_db
DB_USERNAME=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
FLYWAY_ENABLED=true

# Redis Configuration (Enabled in Phase 13)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Configuration
# Generate a 256-bit secret key (e.g., openssl rand -base64 32)
JWT_SECRET=c2VjdXJlX2VudGVycHJpc2VfamF2YV8yMV9zcHJpbmdfYm9vdF9qd3Rfc2VjcmV0X2tleV9leGFtcGxl
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Provider Configuration
# Supported providers: mock | gemini | openai
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
