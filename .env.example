# ==============================================================================
# ResolveAI — Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit the real .env file or real secrets to source control.
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resolveai_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here
FLYWAY_ENABLED=true

# Redis Configuration (Phase 13)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000

# Security & JWT Configuration
# Generate a 256-bit secret key (e.g., openssl rand -base64 32)
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_key_here
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost:3000

# AI Provider Configuration
# Supported providers: openai | mock
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TOP_K=5
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=10

# Docker Exposed Host Ports
BACKEND_PORT=8080
FRONTEND_PORT=80

# Frontend Configuration (Local dev: http://localhost:8080/api | Docker: /api)
VITE_API_BASE_URL=http://localhost:8080/api
