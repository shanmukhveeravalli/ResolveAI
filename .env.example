# ==============================================================================
# ResolveAI — Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit the real .env file or real secrets to source control.
# ==============================================================================

# ==============================================================================
# LOCAL DEVELOPMENT DEFAULTS
# ==============================================================================

# Application Profile: dev | test | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Configuration (PostgreSQL 16 + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resolveai_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here
# SSL mode for DB: disable | allow | prefer | require | verify-ca | verify-full
DB_SSL_MODE=prefer
# HikariCP pool sizing (defaults suitable for most single-host deployments)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
FLYWAY_ENABLED=true

# Redis Configuration (Phase 13)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms
REDIS_SSL_ENABLED=false

# Security & JWT Configuration
# Generate a 256-bit secret key: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_key_here
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Allowed Origins (Comma-separated; in production set to exact frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost:3000

# AI Provider Configuration
# Supported providers: openai | mock
AI_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_TOP_K=5
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=10

# Actuator health details visibility: always | when_authorized | never
ACTUATOR_HEALTH_SHOW_DETAILS=when_authorized

# Swagger/OpenAPI UI (disable in production)
SWAGGER_ENABLED=false

# Docker Exposed Host Ports
# Note: BACKEND_PORT is not exposed on the host by default in docker-compose.yml.
# The backend (port 8080) is internal-only, reachable via the Nginx /api/ proxy.
# FRONTEND_PORT controls which host port Nginx listens on.
FRONTEND_PORT=80

# Frontend Configuration (Docker Compose: use /api for Nginx proxy; Local dev: http://localhost:8080/api)
VITE_API_BASE_URL=/api

# Logging Configuration (Production)
# LOG_LEVEL controls root log level: DEBUG | INFO | WARN | ERROR (default: INFO)
# APP_LOG_LEVEL controls com.resolveai package log level (default: INFO)
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ==============================================================================
# PRODUCTION OVERRIDES (reference for cloud deployment — NEVER commit real values)
# Set SPRING_PROFILES_ACTIVE=prod and populate ALL of the following:
# ==============================================================================
# SPRING_PROFILES_ACTIVE=prod
# SERVER_PORT=8080
# SHUTDOWN_TIMEOUT=30s
#
# -- Database (PostgreSQL 16 + pgvector required) --
# DB_HOST=<managed-postgres-hostname>        # e.g. db.myhost.com
# DB_PORT=5432
# DB_NAME=resolveai_db
# DB_USERNAME=<db-user>
# DB_PASSWORD=<strong-random-password>
# DB_SSL_MODE=require
# DB_POOL_MAX_SIZE=20
# DB_POOL_MIN_IDLE=5
# FLYWAY_ENABLED=true
#
# -- Redis 7 --
# REDIS_HOST=<managed-redis-hostname>        # e.g. redis.myhost.com
# REDIS_PORT=6379
# REDIS_PASSWORD=<strong-random-password>
# REDIS_SSL_ENABLED=true
# REDIS_TIMEOUT=2000ms
#
# -- Security --
# JWT_SECRET=<base64-encoded-256-bit-secret> # openssl rand -base64 32
# JWT_ACCESS_EXPIRATION=900000
# JWT_REFRESH_EXPIRATION=604800000
#
# -- CORS (set to exact frontend origin; no wildcards in production) --
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
#
# -- AI Provider --
# AI_ENABLED=true                            # if using real AI provider
# AI_PROVIDER=openai
# AI_API_KEY=<openai-api-key>
# AI_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIMENSIONS=1536
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT=10
# AI_TOP_K=5
#
# -- Observability --
# ACTUATOR_HEALTH_SHOW_DETAILS=when_authorized
# SWAGGER_ENABLED=false
# LOG_LEVEL=INFO
# APP_LOG_LEVEL=INFO
#
# -- Frontend --
# FRONTEND_PORT=80
# VITE_API_BASE_URL=/api

